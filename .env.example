# Zolexora Marketplace — client-side Firebase config
# These values come from Firebase Console → Project Settings → General → Your apps → Web app (</> icon)
# They are PUBLIC by design (they identify your project to the browser) — safe to ship in frontend code.
# Firebase security is enforced by Firestore/Storage RULES, not by hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=zolexoramarketplace.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zolexoramarketplace
VITE_FIREBASE_STORAGE_BUCKET=zolexoramarketplace.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------
# DO NOT put the service_account JSON (private_key, client_email, etc.)
# in this file or anywhere under your frontend/ directory.
# That key is SERVER-ONLY (Node/Python backend, Cloud Functions, or a
# CI secret manager) and grants full admin access, bypassing all
# security rules. If it ever lands in a browser bundle, git repo, or
# chat log, rotate it immediately in:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# ------------------------------------------------------------------
